global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "/etc/prometheus/alert_rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:{{ alertmanager_port }}"]

scrape_configs:
  - job_name: 'libvirt'
    static_configs:
      - targets: ["localhost:{{ libvirt_exporter_port }}"]

  - job_name: 'openstack-server-group'
    static_configs:
      - targets: ["localhost:{{ server_group_exporter_port }}"]
